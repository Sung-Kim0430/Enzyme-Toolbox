{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "t5m-unlock-tool",
  "version": "0.1.0",
  "identifier": "com.enzymeym.t5m-unlock-tool",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "t5m-unlock-tool",
        "width": 1052,
        "height": 672,
        "decorations": false,
        "minWidth": 1052,
        "minHeight": 672
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
